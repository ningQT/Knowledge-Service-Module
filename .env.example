# KSM Environment Variables
# Copy this file to .env and fill in values
#
# To switch environment:
#   KSM_ENV=test  → loads .env.test
#   KSM_ENV=prod  → loads .env.prod
#   (unset)       → loads .env


# === Data Paths ===
KSM_DATA_DIR=./data/vaults
KSM_TEMPLATE_DIR=./templates
# KSM_CONFIG_DIR=./configs

# === HTTP API ===
KSM_HOST=127.0.0.1
KSM_PORT=8900
KSM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KSM_MAX_UPLOAD_BYTES=10485760
KSM_ENABLE_DOCS=true
KSM_REQUIRE_HTTPS_LLM_BASE_URL=false
# Empty uses environment default: enabled in prod/production, disabled otherwise.
# Set true to block localhost/private LLM URLs in any environment.
# KSM_LLM_SSRF_PROTECTION=
KSM_ENABLE_CSRF_PROTECTION=true
KSM_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KSM_SECURE_COOKIES=false
KSM_TRUST_PROXY_HEADERS=false
KSM_RATE_LIMIT_ENABLED=true
KSM_RATE_LIMIT_WINDOW_SECONDS=60
KSM_RATE_LIMIT_AUTH_PER_WINDOW=10
KSM_RATE_LIMIT_DEFAULT_PER_WINDOW=120
KSM_RATE_LIMIT_WRITE_PER_WINDOW=30
KSM_RATE_LIMIT_HEAVY_PER_WINDOW=10
KSM_SSE_TOKEN_TTL_SECONDS=60
KSM_EXPOSE_ERROR_DETAILS=false
KSM_DB_BACKUP_DIR=./data/backups
KSM_BACKUP_BEFORE_MIGRATION=true

# === Logging ===
KSM_LOG_LEVEL=INFO

# === Git Sync (optional) ===
# KSM_GIT_REPO_DIR=
# KSM_GIT_WEBHOOK_SECRET=
